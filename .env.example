# NetSential Cybersecurity Monitoring Platform Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production

# MySQL Database Configuration (Required: MySQL 8+)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://netsential_user:netsential_pass@localhost:3306/netsential_db

# Optional Test Database URL (if running pytest against isolated MySQL instance)
# TEST_DATABASE_URL=mysql+pymysql://netsential_test:netsential_pass@localhost:3306/netsential_test_db

# Security & Upload Configuration
# Maximum file upload size in bytes (5 MB = 5242880)
MAX_CONTENT_LENGTH=5242880
SESSION_COOKIE_SECURE=False

# Rate Limiting Configuration
RATELIMIT_DEFAULT="200 per day; 50 per hour"
RATELIMIT_LOGIN="5 per minute"

# Threat Detection Engine Configurable Thresholds
# Rule AUTH-001: Repeated Failed Logins
AUTH_FAILED_THRESHOLD=5
AUTH_FAILED_WINDOW_MINUTES=5

# Rule AUTH-002: Excessive Login Attempts Volume
AUTH_VOLUME_THRESHOLD=10
AUTH_VOLUME_WINDOW_MINUTES=10

# Rule IP-001: Watchlisted IP Addresses (comma-separated list of known IOC / malicious IPs)
IP_WATCHLIST=198.51.100.23,203.0.113.50,192.0.2.100,45.33.32.156
